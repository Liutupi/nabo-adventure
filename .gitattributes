# Human-written source uses LF; hash-bound generated/authoring files keep bytes.
* text=auto eol=lf
game-art/adventure/art/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
game-art/adventure/audio/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Immutable glyph masters and vendored upstream formatting are kept byte-for-byte.
game-art/adventure/font-source/** -text -whitespace
firmware/main/third_party/** -text -whitespace
# Art manifests bind the exact bytes of their authoring scripts as provenance.
game-art/adventure/tools/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
firmware/main/generated/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve upstream font license bytes, including their original whitespace.
game-art/adventure/art/**/licenses/*-OFL.txt -text -whitespace
docs/community/**/assets/*-OFL.txt -text -whitespace
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.wav binary
*.mp3 binary
*.bin binary
